+import {resolve} from 'node:path';
+import {createServer} from 'vite';
+
+const [host, portArgument, token] = process.argv.slice(2);
+const port = Number(portArgument);
+let server;
+try {
+  if (!process.send || !token || !Number.isInteger(port) || port < 1 || port > 65535) throw new Error('Owned Vite startup requires its parent IPC channel and exact port');
+  server = await createServer({root: process.cwd(), clearScreen: false, server: {host, port, strictPort: true}});
+  await server.listen();
+  const address = server.httpServer?.address();
+  if (!server.httpServer?.listening || typeof address !== 'object' || address === null || address.port !== port || address.address !== host) throw new Error('Owned Vite listener does not match the requested endpoint');
+  process.send({type: 'lumen-owned-vite-ready', pid: process.pid, token, root: resolve(server.config.root),
+    host, address: address.address, port: address.port, listening: true});
+} catch (error) {
+  process.stderr.write(`${error.stack ?? error}\n`);
+  await server?.close();
+  process.disconnect?.();
+  process.exitCode = 1;
+}
diff --git a/scripts/lib/windows-tcp-listeners.mjs b/scripts/lib/windows-tcp-listeners.mjs
new file mode 100644
index 0000000..a469b58
--- /dev/null
+++ b/scripts/lib/windows-tcp-listeners.mjs
@@ -0,0 +1,29 @@
+import {Buffer} from 'node:buffer';
+import {execFileSync} from 'node:child_process';
+import {fileURLToPath} from 'node:url';
+
+export function parseTcpListeners(bytes) {
+  if (bytes.length < 4) throw new Error('Truncated TCP listener table');
+  const count = bytes.readUInt32LE(0);
+  // MIB_TCPROW_OWNER_PID has six DWORD fields, aligned to DWORD after the count.
+  if (count > (bytes.length - 4) / 24) throw new Error('Truncated TCP listener rows');
+  return Array.from({length: count}, (_, index) => {
+    const offset = 4 + index * 24;
+    return {address: [...bytes.subarray(offset + 4, offset + 8)].join('.'),
+      port: bytes.readUInt16BE(offset + 8), pid: bytes.readUInt32LE(offset + 20),
+      rawState: bytes.readUInt32LE(offset)};
+  });
+}
+
+export function requireOwnedTcpListener(listeners, port, owned) {
+  const matches = listeners.filter(row => row.port === port && row.address === '127.0.0.1');
+  if (matches.length !== 1 || !owned.has(matches[0].pid)) throw new Error('CDP listener is not uniquely owned by the fixture executable');
+  return matches[0];
+}
+
+export function readWindowsTcpListeners() {
+  if (process.platform !== 'win32') throw new Error('TCP listener verification requires Windows');
+  const script = fileURLToPath(new URL('./windows-tcp-listeners.ps1', import.meta.url));
+  const encoded = execFileSync('powershell.exe', ['-NoProfile', '-File', script], {encoding: 'utf8', windowsHide: true, timeout: 20_000}).trim();
+  return parseTcpListeners(Buffer.from(encoded, 'base64'));
+}
diff --git a/scripts/lib/windows-tcp-listeners.ps1 b/scripts/lib/windows-tcp-listeners.ps1
new file mode 100644
index 0000000..f93c2af
--- /dev/null
+++ b/scripts/lib/windows-tcp-listeners.ps1
@@ -0,0 +1,29 @@
+$ErrorActionPreference = 'Stop'
+Add-Type -TypeDefinition @'
+using System;
+using System.Runtime.InteropServices;
+public static class LumenTcpListeners {
+  [DllImport("iphlpapi.dll")]
+  public static extern uint GetExtendedTcpTable(IntPtr table, ref uint size, bool order, uint family, uint tableClass, uint reserved);
+}
+'@
+
+# AF_INET + TCP_TABLE_OWNER_PID_LISTENER requests listeners only, independently of CIM state decoding.
+[uint32]$size = 0
+$status = [LumenTcpListeners]::GetExtendedTcpTable([IntPtr]::Zero, [ref]$size, $false, 2, 3, 0)
+if ($status -ne 122) { throw "TCP listener sizing failed: $status" }
+for ($attempt = 0; $attempt -lt 3; $attempt++) {
+  if ($size -lt 4 -or $size -gt 1048576) { throw 'Invalid TCP listener table size' }
+  $buffer = [Runtime.InteropServices.Marshal]::AllocHGlobal([int]$size)
+  try {
+    $capacity = $size
+    $status = [LumenTcpListeners]::GetExtendedTcpTable($buffer, [ref]$size, $false, 2, 3, 0)
+    if ($status -eq 122) { continue }
+    if ($status -ne 0 -or $size -gt $capacity) { throw "TCP listener enumeration failed: $status" }
+    $bytes = New-Object byte[] $size
+    [Runtime.InteropServices.Marshal]::Copy($buffer, $bytes, 0, [int]$size)
+    [Convert]::ToBase64String($bytes)
+    exit 0
+  } finally { [Runtime.InteropServices.Marshal]::FreeHGlobal($buffer) }
+}
+throw 'TCP listener table kept changing during enumeration'
