+    --color-icon-secondary: var(--lumen-text-secondary);
+    --color-icon-disabled: var(--lumen-text-tertiary);
+    --color-icon-accent: var(--lumen-accent);
+    --color-on-accent: var(--lumen-text-inverse);
+    --color-background-body: var(--lumen-canvas);
