         <UNSAFE_PortalProvider getContainer={() => portalContainerRef.current ?? document.body}>
           <Profiler id="Lumen" onRender={recordCommit}>{children}</Profiler>
         </UNSAFE_PortalProvider>
-      </div>
+      </FluentProvider>
     </LumenMotionProvider>
   );
 }
